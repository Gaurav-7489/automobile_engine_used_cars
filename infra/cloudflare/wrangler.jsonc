{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vandlabs-gateway",
  "main": "src/gateway.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://vandlabs-gateway.vandlabs-automobile.workers.dev"
  },
  "services": [
    {
      "binding": "WEB",
      "service": "vandlabs-web"
    },
    {
      "binding": "COMMAND",
      "service": "vandlabs-command-center"
    },
    {
      "binding": "PLATFORM",
      "service": "vandlabs-platform"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "Admission",
        "script_name": "vandlabs-admission"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "VEHICLE_MEDIA",
      "bucket_name": "vandlabs-vehicle-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 1000
  },
  "account_id": "98f548fdf2e2be84591c6669493f330b",
  "routes": []
}
