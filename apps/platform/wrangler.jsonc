{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vandlabs-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vandlabs-platform"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vandlabs-platform-cache"
    },
    {
      "binding": "VEHICLE_MEDIA",
      "bucket_name": "vandlabs-vehicle-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMISSION",
        "class_name": "Admission",
        "script_name": "vandlabs-admission"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 10000
  },
  "vars": {
    "HOSTING_PROVIDER": "cloudflare",
    "DATA_MODE": "demo",
    "AUTH_MODE": "demo",
    "NEXT_PUBLIC_PREVIEW_READ_ONLY": "true",
    "DATABASE_POOL_MAX": "2"
  }
}
