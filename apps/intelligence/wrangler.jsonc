{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vandlabs-intelligence",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vandlabs-intelligence"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vandlabs-intelligence-cache"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 10000
  },
  "vars": {
    "HOSTING_PROVIDER": "cloudflare",
    "DATABASE_POOL_MAX": "2",
    "APP_ORIGIN": "https://intelligence.example"
  },
  "account_id": "98f548fdf2e2be84591c6669493f330b"
}
