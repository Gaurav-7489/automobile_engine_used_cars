{
  // The one web application and its API: sign-in, dealership workspace and VandLabs administration. Staging only until the acceptance
  // checklist in docs/CLOUDFLARE_MIGRATION_AND_ROLLBACK.md passes; Vercel stays the live host until then.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vandlabs-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vandlabs-app" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vandlabs-app-cache" },
    { "binding": "VEHICLE_MEDIA", "bucket_name": "vandlabs-vehicle-media" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  // Password hashing (scrypt) and the first read-model backfill are CPU heavy; this needs the Workers paid plan.
  "limits": { "cpu_ms": 10000 },
  "vars": {
    "HOSTING_PROVIDER": "cloudflare",
    "NODE_ENV": "production",
    "DATABASE_POOL_MAX": "2",
    // Replace with the staging hostname; SESSION_SECRET, DATABASE_URL (pooled Neon application role) are Worker secrets, never vars.
    "APP_ORIGIN": "https://app-staging.example.invalid"
  }
}
