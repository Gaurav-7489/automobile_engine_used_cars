{
  "name": "vandlabs-automobile-engine",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint apps packages tests playwright*.config.ts",
    "test:e2e": "playwright test",
    "qa": "pnpm lint && pnpm typecheck && pnpm test:security && pnpm test:database && pnpm test:intelligence && pnpm test:product && pnpm test:intelligence-prod && pnpm test:cloudflare && pnpm build && pnpm test:e2e && pnpm test:auth:e2e && pnpm test:roles:e2e",
    "test:security": "node --import tsx --test tests/security/*.test.ts",
    "test:auth:e2e": "playwright test --config playwright.auth.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "db:migrate": "node --import tsx scripts/database/migrate.ts",
    "db:seed": "node --import tsx scripts/database/seed.ts",
    "test:database": "node --import tsx --test tests/database/*.test.ts",
    "db:provision-role": "node --import tsx scripts/database/provision-role.ts",
    "demo": "node scripts/start-demo.mjs",
    "test:intelligence": "node --import tsx --test tests/intelligence/*.test.ts",
    "db:provision-tenant": "node --import tsx scripts/database/provision-tenant.ts",
    "deployment:doctor": "node --import tsx scripts/deployment/doctor.ts",
    "test:cloudflare": "node --import tsx --test tests/cloudflare/*.test.ts tests/cloudflare/*.test.mjs",
    "cf:build": "pnpm --filter @vandlabs/web cf:build && pnpm --filter @vandlabs/command-center cf:build && pnpm --filter @vandlabs/platform cf:build",
    "cf:configure": "node scripts/cloudflare/configure.mjs",
    "cf:deploy": "node scripts/cloudflare/deploy.mjs",
    "test:roles:e2e": "playwright test --config playwright.roles.config.ts",
    "test:product": "node --import tsx --test tests/product-ui/*.test.ts",
    "test:intelligence-prod": "node --import tsx --test tests/intelligence-prod/*.test.ts",
    "intelligence:provision": "node --import tsx scripts/intelligence/provision-workspace.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "axe-core": "4.13.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.27",
    "fflate": "0.8.3",
    "jose": "^6.2.12",
    "tsx": "^4.20.6",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.149.0"
  }
}
