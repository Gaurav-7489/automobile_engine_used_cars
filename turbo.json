{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    }
  },
  "globalEnv": [
    "DATA_MODE",
    "AUTH_MODE",
    "TENANT_CONFIG_JSON",
    "APP_ORIGIN",
    "COGNITO_DOMAIN",
    "COGNITO_USER_POOL_ID",
    "COGNITO_CLIENT_ID",
    "COGNITO_CLIENT_IDS",
    "SESSION_SECRET",
    "AUTH_PRINCIPALS_JSON",
    "DATABASE_URL",
    "DATABASE_HOST",
    "DATABASE_NAME",
    "DATABASE_PORT",
    "DATABASE_SECRET_ARN",
    "DATABASE_TLS",
    "DATABASE_SSL_CA_FILE",
    "AUTH_REGISTRY_MODE",
    "DATABASE_SSL_CA",
    "DATABASE_POOL_MAX",
    "NEXT_PUBLIC_PREVIEW_READ_ONLY",
    "VERCEL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "RATE_LIMIT_NAMESPACE",
    "RATE_LIMIT_TRUSTED_IP_HEADER",
    "COGNITO_DESKTOP_CLIENT_ID",
    "HOSTING_PROVIDER",
    "SITE_ORIGIN",
    "SEO_INDEXABLE",
    "GOOGLE_SITE_VERIFICATION",
    "NOTIFICATIONS_ENABLED",
    "RESEND_API_KEY",
    "NOTIFICATION_FROM",
    "NOTIFICATION_TO",
    "OIDC_ISSUER",
    "OIDC_RESOURCE",
    "OIDC_AUDIENCE",
    "OIDC_JWKS_URL",
    "OIDC_CLIENT_ID",
    "OIDC_AUTHORIZE_URL",
    "OIDC_TOKEN_URL",
    "OIDC_REVOKE_URL",
    "OIDC_DESKTOP_CLIENT_ID"
  ]
}
