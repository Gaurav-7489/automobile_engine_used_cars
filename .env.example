# Reference mode (local demo only). Use the production guide before real deployment.
AUTH_MODE=demo
DATA_MODE=demo
# Production server configuration:
# AUTH_MODE=cognito
# DATA_MODE=aurora
# APP_ORIGIN=https://operations.example.com
# COGNITO_DOMAIN=https://your-prefix.auth.your-region.amazoncognito.com
# COGNITO_USER_POOL_ID=your-region_userpool
# COGNITO_CLIENT_ID=web-client-id
# COGNITO_CLIENT_IDS=web-client-id,desktop-client-id
# SESSION_SECRET=32-random-bytes-encoded-as-base64
# AUTH_PRINCIPALS_JSON={"verified-cognito-sub":{"tenantId":"uuid","dealershipIds":["uuid"],"locationIds":["uuid"],"capabilities":["inventory:read","inventory:write","lead:read","lead:write","task:write","analytics:read"]}}
# TENANT_CONFIG_JSON=full-dealership-config-with-production-uuid-identifiers
# DATABASE_SECRET_ARN=application-role-secret-arn
# DATABASE_HOST=aurora-endpoint
# DATABASE_NAME=automobile_engine
# DATABASE_SSL_CA_FILE=/absolute/path/to/rds-ca-bundle.pem
# AWS_REGION=your-region
# Migration/provisioning only, never in browser or desktop:
# MIGRATION_DATABASE_URL=admin-postgresql-connection-url-with-verified-tls
# APPLICATION_DATABASE_SECRET_ARN=application-role-secret-arn

# Persistent staff registry (after migration 0005 and initial grants):
# AUTH_REGISTRY_MODE=database
# Bootstrap admins only in AUTH_PRINCIPALS_JSON; use platformTenantIds for explicit admin scopes.
# Hosted PostgreSQL may use an application-role DATABASE_URL instead of Secrets Manager.
# DATABASE_URL=postgresql-application-role-url
# DATABASE_SSL_CA=trusted-CA-PEM-from-secure-configuration
# DATABASE_POOL_MAX=2
# NEXT_PUBLIC_PREVIEW_READ_ONLY=true until shared staging acceptance, then rebuild with false.

# Shared public request protection (required for DATA_MODE=aurora public writes).
# UPSTASH_REDIS_REST_URL=https://your-redis-rest-endpoint
# UPSTASH_REDIS_REST_TOKEN=configure-in-secret-store
# RATE_LIMIT_NAMESPACE=automobile-staging
# Vercel's injected x-forwarded-for is used only when VERCEL=1.
# For another host, set RATE_LIMIT_TRUSTED_IP_HEADER only when your proxy strips
# caller-supplied values and inserts the real IP. Unknown clients share a bounded bucket.
# RATE_LIMIT_TRUSTED_IP_HEADER=x-your-trusted-proxy-ip

# Desktop discovery: public client identifier, never a client secret.
# COGNITO_DESKTOP_CLIENT_ID=public-native-client-id
# The native client must also appear in COGNITO_CLIENT_IDS for staff API verification.

# Preferred low-cost deployment: Cloudflare Workers + R2 + Neon + Resend.
# HOSTING_PROVIDER=cloudflare
# DATA_MODE=neon
# AUTH_MODE=oidc
# SITE_ORIGIN=https://your-real-domain.com
# CF_PUBLIC_ORIGIN=https://your-real-domain.com
# CF_SHARED_DATA=true
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=secret-store-only-scoped-token
# DATABASE_URL=postgresql://vandlabs_runtime:secret@your-endpoint-pooler.region.aws.neon.tech/neondb
# APPLICATION_DATABASE_PASSWORD=role-provisioning-only-secret
# MIGRATION_DATABASE_URL=direct-neon-admin-url-provisioning-only
# AUTH_REGISTRY_MODE=database
# OIDC_ISSUER=https://your-identity-provider
# OIDC_JWKS_URL=https://your-identity-provider/.well-known/jwks.json
# OIDC_AUDIENCE=dealer-api-resource-not-the-browser-client-id
# OIDC_CLIENT_ID=public-browser-oauth-client
# OIDC_DESKTOP_CLIENT_ID=public-native-oauth-client
# OIDC_AUTHORIZE_URL=https://your-identity-provider/authorize
# OIDC_TOKEN_URL=https://your-identity-provider/oauth/token
# OIDC_REVOKE_URL=https://your-identity-provider/oauth/revoke
# OIDC_RESOURCE=optional-standards-based-resource-parameter
# SEO_INDEXABLE=true
# GOOGLE_SITE_VERIFICATION=google-issued-property-verification-token
# NOTIFICATIONS_ENABLED=true
# RESEND_API_KEY=secret-store-only
# NOTIFICATION_FROM=VandLabs <notifications@your-verified-domain.com>
# NOTIFICATION_TO=authorized-dealership-owner@your-domain.com

# APPLICATION_DATABASE_USER=vandlabs_runtime # SQL-created restricted role on Neon

# --- VandLabs Automobile Intelligence (apps/intelligence) ---
# DATABASE_URL=postgres://vandlabs_runtime:...@ep-xxxx-pooler.region.aws.neon.tech/automobile_engine?sslmode=require   # pooled URL, restricted role (never neondb_owner)
# SESSION_SECRET=<32+ random characters>        # required; sign-in fails closed without it
# DATABASE_POOL_MAX=2                           # optional; defaults to 2 on Vercel
# MIGRATION_DATABASE_URL=...                    # administrators only; used by `pnpm db:migrate` and `pnpm intelligence:provision`, never set on the web deployment
# APP_ORIGIN=https://intelligence.example.com   # administrators only; used to print the owner setup link

# --- Assistant, Google sign-in and advertising accounts (apps/intelligence) ---
# ANTHROPIC_API_KEY=secret-store-only            # turns on the Assistant page; without it the page says it is not set up
# ASSISTANT_MODEL=claude-opus-5-5                # optional override
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com # Google Cloud OAuth client (Web). Enables "Continue with Google" on /login
# GOOGLE_CLIENT_SECRET=secret-store-only
#   Authorised redirect URIs: {APP_ORIGIN}/api/auth/sso/google/callback and {APP_ORIGIN}/api/advertising/accounts/google/callback
# GOOGLE_ADS_DEVELOPER_TOKEN=secret-store-only   # from a Google Ads manager account; needed to connect Google Ads
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890        # optional: manager account id, digits only
# GOOGLE_ADS_API_VERSION=v23                     # optional: bump when Google retires a version
# META_APP_ID=...                                # Meta app with Facebook Login and the Marketing API
# META_APP_SECRET=secret-store-only
#   Valid OAuth redirect URI: {APP_ORIGIN}/api/advertising/accounts/meta/callback
# META_API_VERSION=v24.0                         # optional
# TOKEN_ENCRYPTION_KEY=<32+ random characters>   # optional: encrypts stored ad tokens; falls back to SESSION_SECRET
